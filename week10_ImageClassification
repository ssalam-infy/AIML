# ================================================================
# IMAGE CLASSIFICATION USING PRETRAINED RESNET-50 (TORCHVISION)
# ================================================================
# This script downloads an image from the web, applies preprocessing,
# runs inference using a pretrained ResNet-50 model, and prints the
# top predicted ImageNet class.
# ================================================================

# -------------------------------
# 1. Import Required Libraries
# -------------------------------
import torch
from torchvision import models, transforms
from PIL import Image
import requests
from io import BytesIO

# -------------------------------
# 2. Load an Image from the Web
# -------------------------------
# Some servers block requests without a User-Agent header.
# We add headers to prevent 403 errors.
img_url = "https://upload.wikimedia.org/wikipedia/commons/2/26/YellowLabradorLooking_new.jpg"
headers = {"User-Agent": "Mozilla/5.0"}

# Fetch the image
response = requests.get(img_url, headers=headers)

# Validate that the response contains an image
if response.status_code == 200 and "image" in response.headers.get("Content-Type", ""):
    img = Image.open(BytesIO(response.content)).convert("RGB")
else:
    raise ValueError(f"Failed to fetch valid image. Status: {response.status_code}")

# Optional: Display image (works in Jupyter or Colab)
# img.show()

# -------------------------------
# 3. Preprocessing Pipeline
# -------------------------------
# ResNet-50 expects 224×224 RGB images normalized to ImageNet statistics.
preprocess = transforms.Compose([
    transforms.Resize(256),                     # Resize shortest side to 256 px
    transforms.CenterCrop(224),                 # Crop center 224×224 region
    transforms.ToTensor(),                      # Convert to PyTorch tensor
    transforms.Normalize(                       # Normalize per ImageNet mean/std
        mean=[0.485, 0.456, 0.406],
        std=[0.229, 0.224, 0.225]
    ),
])

# Convert image → tensor and add batch dimension [1, 3, 224, 224]
input_tensor = preprocess(img)
input_batch = input_tensor.unsqueeze(0)

# -------------------------------
# 4. Load Pretrained ResNet-50
# -------------------------------
# pretrained=True loads weights trained on ImageNet-1K dataset.
model = models.resnet50(pretrained=True)
model.eval()  # Set model to evaluation mode (disable dropout, BN updates)

# -------------------------------
# 5. Perform Inference
# -------------------------------
# Disable gradient computation for faster inference.
with torch.no_grad():
    output = model(input_batch)  # Forward pass

# -------------------------------
# 6. Process Model Output
# -------------------------------
# Convert raw logits → probabilities using softmax
probabilities = torch.nn.functional.softmax(output[0], dim=0)

# Get the top predicted class index
_, class_id = torch.topk(probabilities, 1)
class_id = class_id.item()

# -------------------------------
# 7. Load ImageNet Labels
# -------------------------------
labels_url = "https://raw.githubusercontent.com/pytorch/hub/master/imagenet_classes.txt"
labels = requests.get(labels_url, headers=headers).text.strip().split("\n")

# -------------------------------
# 8. Print the Prediction
# -------------------------------
print(f"Predicted Class: {labels[class_id]}")

# ================================================================
# END OF SCRIPT
# ================================================================
